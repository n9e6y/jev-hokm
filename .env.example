# Jev (phase 4): API key from TypeSafe, read by typesafe-sdk
TYPESAFE_API_KEY=
# Pinned Jev model version (never a moving alias like jev-latest; see docs/JEV.md)
JEV_MODEL=

# Postgres (phase 3): matches docker-compose.yml; driver suffix chosen when the DB layer lands
DATABASE_URL=postgresql://hokm:hokm@localhost:5432/hokm
